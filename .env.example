# Copy this file to .env and fill in the values for your own Supabase project.
# .env is git-ignored — never commit real keys.

# Your Supabase project ref (the subdomain of your project URL).
VITE_SUPABASE_PROJECT_ID=""

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=""

# The PUBLISHABLE (anon) key only — it starts with "sb_publishable_".
#
# This value is compiled into the browser bundle and is public by design, so it
# must be the publishable key and nothing else. Never put a service_role key or
# any legacy "service_role" JWT here: that key bypasses Row Level Security and
# would give anyone who views the site full read/write access to your database.
#
# Find it in the Supabase dashboard under Project Settings -> API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=""
